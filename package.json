{
  "name": "@_linked/s3",
  "displayName": "s3",
  "description": "A general purpose Simple Storage Service (S3) package to be extended or used as is",
  "author": {
    "name": "Valentine Wilson",
    "email": "valentine@semantu.com",
    "url": "https://vw.codes"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-fw/s3.git"
  },
  "version": "1.6.3",
  "packageManager": "npm@12.2.0",
  "linkedPackage": true,
  "type": "module",
  "main": "lib/esm/index.js",
  "types": "index.d.ts",
  "license": "ISC",
  "files": [
    "lib",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "npm exec linked dev",
    "build": "linked build",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs && npm run typecheck",
    "typecheck": "tsc -p tsconfig-tests.json"
  },
  "keywords": [
    "lincd",
    "linked data",
    "interoperable",
    "semantic web",
    "web3",
    "s3",
    "simple storage service",
    "cloud storage",
    "aws"
  ],
  "dependencies": {
    "@_linked/core": "^2.22.8",
    "@_linked/server-utils": "^1.0",
    "@aws-sdk/client-s3": "^3.159.0",
    "@aws-sdk/credential-providers": "^3.159.0",
    "mime": "4.1.0"
  },
  "devDependencies": {
    "@_linked/cli": "^1.45.5",
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.0",
    "@jest/globals": "^30.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.0.0",
    "ts-jest": "^29.4.12",
    "tsconfig-to-dual-package": "^1.2.0",
    "typescript": "^5.7.3",
    "typescript-plugin-css-modules": "^5.1.0"
  },
  "module": "lib/esm/index.js",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
