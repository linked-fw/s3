{
  "name": "@_linked/s3",
  "displayName": "s3",
  "description": "A general purpose Simple Storage Service (S3) package to be extended or used as is",
  "author": {
    "name": "Valentine Wilson",
    "email": "valentine@semantu.com",
    "url": "https://vw.codes"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linked-fw/s3.git"
  },
  "version": "1.2.2",
  "packageManager": "npm@11.19.1",
  "linkedPackage": true,
  "type": "module",
  "main": "lib/esm/index.js",
  "types": "./lib/esm/index.d.ts",
  "license": "ISC",
  "scripts": {
    "start": "npm exec linked dev",
    "build": "rimraf ./lib && npm run build-esm && npm run copy-to-lib",
    "build-esm": "echo \"compiling ESM\" && rimraf ./lib/esm && tsc -p tsconfig-esm.json",
    "copy-to-lib": "echo 'copying JSON assets to lib folder' && copyfiles -u 1 'src/**/*.json' lib/esm",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.config.cjs && npm run typecheck",
    "typecheck": "tsc -p tsconfig-tests.json"
  },
  "keywords": [
    "lincd",
    "linked data",
    "interoperable",
    "semantic web",
    "web3",
    "s3",
    "simple storage service",
    "cloud storage",
    "aws"
  ],
  "dependencies": {
    "@_linked/core": "^2.21.0",
    "@_linked/server": "^2.5.1",
    "@_linked/server-utils": "^1.0",
    "@aws-sdk/client-s3": "^3.159.0",
    "@aws-sdk/credential-providers": "^3.159.0",
    "cron": "^3.1.7",
    "mime": "2.6.0"
  },
  "devDependencies": {
    "@_linked/cli": "^1.19.0",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/mime": "^3.0.4",
    "@types/node": "^20.19.43",
    "copyfiles": "^2.4.1",
    "jest": "^29.7.0",
    "rimraf": "^5.0.7",
    "ts-jest": "^29.4.12",
    "tsconfig-to-dual-package": "^1.2.0",
    "typescript": "^5.7.3",
    "typescript-plugin-css-modules": "^5.1.0"
  },
  "module": "lib/esm/index.js",
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
